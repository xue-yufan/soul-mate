# npm install 时 electron 包下载二进制走 npmmirror（国内）
electron_mirror=https://npmmirror.com/mirrors/electron/

# electron-builder 打包时下载 winCodeSign / nsis 等资源走 npmmirror
# npm 会把它转成 npm_config_electron_builder_binaries_mirror 环境变量，
# 正好命中 electron-builder 的查找列表（见 app-builder-lib/out/util/electronGet.js）
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
